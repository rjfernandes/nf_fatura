DATABASE_URL="file:./prisma/dev.db"
PORT=3333

# --- NFS-e Nacional ---
NFSE_ENV=homologacao            # homologacao | producao
NFSE_CERT_PFX_PATH=./certs/empresa.pfx
NFSE_CERT_PFX_PASSWORD=
COMPANY_CNPJ=03894412000100
COMPANY_NAME="MRF INFORMATICA LTDA"  # usado no cabeçalho do extrato PDF
COMPANY_MUNICIPAL_REGISTRATION=
COMPANY_CITY_IBGE=3303302       # 7 dígitos (Niterói)
COMPANY_PHONE=                  # <fone> do prestador
COMPANY_EMAIL=                  # <email> do prestador
NFSE_SERVICE_CODE=010701        # cTribNac, 6 dígitos
NFSE_MUNICIPAL_SERVICE_CODE=001 # cTribMun
NFSE_NBS_CODE=115013000         # cNBS
NFSE_SERVICE_DESCRIPTION="Serviços de informática prestados Valor aproximado dos tributos: 6%"
NFSE_SIMPLES_NACIONAL=3         # 1 não optante | 2 MEI | 3 ME/EPP
NFSE_REG_AP_TRIB_SN=1           # regApTribSN (só com opSimpNac=3)
NFSE_ISS_RATE_PERCENT=0         # só usado quando NFSE_SIMPLES_NACIONAL=1
NFSE_TOT_TRIB_SN_PERCENT=6      # pTotTribSN (só com Simples)
NFSE_SERIES=70000               # série da DPS (a do Emissor Web)
NFSE_DPS_OFFSET=14              # último nDPS já usado na série; o sistema continua a partir do próximo

# --- Banco Inter Empresas ---
INTER_ENV=sandbox               # sandbox | producao
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
INTER_ACCOUNT=                  # conta corrente com dígito (header x-conta-corrente)
INTER_BRANCH=0001-9             # agência, exibida no extrato exportado

# --- Camim (envio de NFS-e + boleto) ---
CAMIM_BASE_URL=https://pj.camim.com.br/api
CAMIM_TOKEN=
