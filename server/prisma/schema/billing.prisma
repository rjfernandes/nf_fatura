model Billing {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  competence  String // YYYY-MM
  amountCents Int
  dueDate     String // YYYY-MM-DD
  issueNfse   Boolean   @default(true)
  issueSlip   Boolean   @default(false)
  status      String    @default("PENDING") // PENDING | NFSE_ISSUED | COMPLETED | FAILED
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoice     Invoice?
  bankSlip    BankSlip?
  delivery    Delivery?
}
