// Delivery of the NFS-e, the boleto or both to the customer through its
// integration. No row means nothing was sent yet.
model Delivery {
  id          String    @id @default(cuid())
  billingId   String    @unique
  billing     Billing   @relation(fields: [billingId], references: [id])
  integration String // CAMIM
  parts       String    @default("BOTH") // NFSE | SLIP | BOTH
  status      String // SENT | FAILED
  error       String?
  response    String? // raw API response, for diagnostics
  sentAt      DateTime?
  updatedAt   DateTime  @updatedAt
}
