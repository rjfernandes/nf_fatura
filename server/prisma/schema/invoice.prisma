model Invoice {
  id        String  @id @default(cuid())
  billingId String  @unique
  billing   Billing @relation(fields: [billingId], references: [id])
  number    String?
  accessKey String? @unique
  xml       String?
  pdf       Bytes?
  raw       String?
  source    String  @default("API") // API | MANUAL | IMPORTED
}
